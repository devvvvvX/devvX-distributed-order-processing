# =============================================================
# Order Platform — Phase 3 Configuration
# =============================================================
# Copy this file to .env and adjust values for your environment.
# In production, these would come from your secrets manager / orchestrator.

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://orderplatform:orderplatform_dev@localhost:5432/order_platform

# Connection Pool
# 🔍 LEARNING NOTE: Pool size matters. Too few = requests queue waiting for connections.
# Too many = PostgreSQL runs out of memory (each connection uses ~5-10MB).
# Rule of thumb: connections = (core_count * 2) + effective_spindle_count
# For dev, 10 is fine. For production, measure and tune.
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=debug

# Notification Simulation
# 🔍 LEARNING NOTE: These settings control the simulated email service.
# Used by the notification consumer to simulate real-world latency/failures.
NOTIFICATION_DELAY_MS=500
NOTIFICATION_FAILURE_RATE=0.0

# Kafka
# 🔍 LEARNING NOTE: Leave KAFKA_BROKERS empty to run without Kafka.
# The API will start and handle orders, just without event publishing.
# Events will accumulate in the outbox table until Kafka is available.
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=order-Platform
KAFKA_CONSUMER_GROUP_ID=notification-service
KAFKA_TOPIC_ORDER_EVENTS=order-events

# Dead Letter Queue (Phase 3)
# 🔍 LEARNING NOTE: Events that exhaust all retry attempts are sent here.
# Monitor this topic via Kafka UI — any messages = something is wrong.
KAFKA_TOPIC_DLQ=order-events-dlq

# Consumer Retry (Phase 3)
# 🔍 LEARNING NOTE: Exponential backoff with jitter prevents thundering herd.
# After CONSUMER_MAX_RETRIES failures, the event goes to DLQ.
# CONSUMER_RETRY_BASE_DELAY_MS is the initial backoff delay; it doubles per retry.
# Max retries = 3 means: 1 initial attempt + 3 retries = 4 total attempts.
CONSUMER_MAX_RETRIES=3
CONSUMER_RETRY_BASE_DELAY_MS=1000

# Outbox Relay (Phase 3)
# 🔍 LEARNING NOTE: The outbox relay polls the outbox_events table at this
# interval. Lower = faster delivery, higher = less DB load.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50

# Graceful Shutdown
SHUTDOWN_TIMEOUT_MS=10000
